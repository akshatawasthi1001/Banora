FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins for production CORS.
# When set, this overrides FRONTEND_URL for CORS purposes.
CORS_ALLOW_ORIGINS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banora
DB_USER=banora
DB_PASSWORD=change-me
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Login/register rate limiting (per IP): attempts allowed per window.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
