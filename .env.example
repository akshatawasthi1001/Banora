# Banora root environment (used by docker compose).
# Copy to .env and fill in real values before starting the services.
# NEVER commit a real .env file.

# Public URL of the frontend (used by the backend for CORS in development).
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed browser origins for production CORS.
# When set, this overrides FRONTEND_URL for CORS purposes.
# Example: CORS_ALLOW_ORIGINS=https://banora.example.com,https://www.banora.example.com
CORS_ALLOW_ORIGINS=

# PostgreSQL credentials for the database container.
DB_NAME=banora
DB_USER=banora
# Required: the backend refuses to start without a database password.
DB_PASSWORD=change-me-strong-local-password

# Required: signing key for JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Login/register rate limiting (per IP): attempts allowed per window.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
